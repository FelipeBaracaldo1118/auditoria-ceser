# --- Google Drive -----------------------------------------------------------
# Los archivos se identifican por File ID, nunca por nombre.
GOOGLE_DRIVE_REPUESTOS_FILE_ID=
GOOGLE_DRIVE_ASEGURADORAS_FILE_ID=

# Produccion: service account con acceso de lectura a los dos archivos.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Desarrollo local: OAuth de escritorio (alternativa a la service account).
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=
GOOGLE_OAUTH_TOKEN_FILE=

# --- Estructura esperada de los archivos ------------------------------------
REPUESTOS_HOJAS_ESPERADAS=4
ASEGURADORAS_HOJAS_ESPERADAS=6

# --- Rutas locales ----------------------------------------------------------
DATA_DIR=
REPORTS_DIR=

# --- MariaDB / TECH (SOLO LECTURA) ------------------------------------------
TECH_DB_HOST=
TECH_DB_PORT=3306
TECH_DB_NAME=ceser
TECH_DB_USER=auditoria_ro
TECH_DB_PASSWORD=

# Limites de seguridad: `ordenes` es MyISAM y un escaneo bloquea la tabla.
TECH_DB_CONNECT_TIMEOUT=10
TECH_DB_READ_TIMEOUT=60
TECH_DB_TAMANO_LOTE=500

# --- Base de auditoria (aun NO se usa) --------------------------------------
# Base de auditoria. Sin nada definido se usa SQLite en data/auditoria.db.
# AUDIT_DB_URL=
# AUDIT_DB_HOST=
# AUDIT_DB_PORT=3306
# AUDIT_DB_NAME=
# AUDIT_DB_USER=
# AUDIT_DB_PASSWORD=

# Enlace a la orden dentro de TECH, para que los reportes lleven al sistema.
# {orden} se reemplaza por el numero de orden.
TECH_APP_URL_ORDEN=https://app.ceser.com.co/php/val_consulta_seguro.php?orden={orden}

# Las ordenes con estos prefijos se consultan en otra pagina del sistema.
TECH_APP_URL_ORDEN_ALTERNA=https://app.ceser.com.co/php/locorden.php?orden={orden}
TECH_PREFIJOS_ORDEN_ALTERNA=119,125,127
